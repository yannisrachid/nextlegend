S3_SECRET_KEY=minio_password

# API base URLs
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CRM migration source (former findyourlegend Neon DB)
CRM_SOURCE_DATABASE_URL=

# Misc placeholders
