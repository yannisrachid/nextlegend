# Core database settings
POSTGRES_DB=nextlegend
POSTGRES_USER=nextlegend
POSTGRES_PASSWORD=nextlegend_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nextlegend:nextlegend_dev_password@db:5432/nextlegend

# Object storage
# Par défaut, on pointe sur AWS S3 (remplacer <...> par vos valeurs).
# MinIO reste utilisable en local : S3_ENDPOINT=http://minio:9000 et S3_ACCESS_KEY/S3_SECRET_KEY = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_BUCKET=nextlegend
S3_ACCESS_KEY=<your_aws_access_key>
S3_SECRET_KEY=<your_aws_secret_key>

# API base URLs
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Misc placeholders
ENVIRONMENT=development
